{
  "name": "orbitly-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Orbitly — Global social media scheduling and publishing platform. Plan once. Publish everywhere.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "pnpm --filter @orbitly/web test:e2e",
    "db:generate": "pnpm --filter @orbitly/db generate",
    "db:push": "pnpm --filter @orbitly/db push",
    "db:migrate": "pnpm --filter @orbitly/db migrate",
    "db:seed": "pnpm --filter @orbitly/db seed",
    "db:studio": "pnpm --filter @orbitly/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "next": "^15.1.0",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
