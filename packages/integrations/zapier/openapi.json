{
  "openapi": "3.0.3",
  "info": {
    "title": "Orbitly Public API & Zapier Integration",
    "version": "1.0.0",
    "description": "OpenAPI definition for Orbitly's Zapier & Make integrations."
  },
  "servers": [
    {
      "url": "https://api.orbitly.io/public/v1",
      "description": "Production Orbitly API"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Key"
      }
    },
    "schemas": {
      "PostCreate": {
        "type": "object",
        "required": ["content", "channelIds"],
        "properties": {
          "content": { "type": "string" },
          "channelIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scheduledAt": { "type": "string", "format": "date-time" },
          "mediaUrls": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          }
        }
      },
      "WebhookSubscription": {
        "type": "object",
        "required": ["url", "events"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "events": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "security": [
    { "BearerAuth": [] }
  ],
  "paths": {
    "/channels": {
      "get": {
        "summary": "List channels",
        "operationId": "listChannels",
        "responses": {
          "200": { "description": "List of connected social channels" }
        }
      }
    },
    "/posts": {
      "get": {
        "summary": "List posts",
        "operationId": "listPosts",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated list of posts" }
        }
      },
      "post": {
        "summary": "Create post",
        "operationId": "createPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PostCreate" }
            }
          }
        },
        "responses": {
          "201": { "description": "Post created" }
        }
      }
    },
    "/media/upload-url": {
      "post": {
        "summary": "Request media upload URL",
        "operationId": "uploadMedia",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fileName"],
                "properties": {
                  "fileName": { "type": "string" },
                  "mimeType": { "type": "string", "default": "image/png" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Signed upload URL and public CDN URL" }
        }
      }
    },
    "/webhooks": {
      "post": {
        "summary": "Subscribe webhook trigger",
        "operationId": "subscribeWebhook",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WebhookSubscription" }
            }
          }
        },
        "responses": {
          "201": { "description": "Webhook registered" }
        }
      }
    },
    "/webhooks/{id}": {
      "delete": {
        "summary": "Unsubscribe webhook trigger",
        "operationId": "unsubscribeWebhook",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Webhook removed" }
        }
      }
    }
  }
}
