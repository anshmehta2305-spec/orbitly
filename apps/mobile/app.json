{
  "expo": {
    "name": "Orbitly",
    "slug": "orbitly-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "orbitly",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090a10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.orbitly.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Orbitly needs camera access to capture photos and videos for social posts.",
        "NSPhotoLibraryUsageDescription": "Orbitly needs photo library access to upload images and videos for scheduling."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090a10"
      },
      "package": "io.orbitly.mobile",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "READ_MEDIA_VIDEO"]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1"
        }
      ]
    ]
  }
}
