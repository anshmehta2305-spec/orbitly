# ==========================================
# Orbitly - Environment Variables Template
# Production & Development Configuration
# ==========================================

# ------------------------------------------
# Environment & Host
# ------------------------------------------
NODE_ENV=development
PORT=3000
API_PORT=4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://orbitly.app

# ------------------------------------------
# Database & Cache
# ------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://orbitly:orbitly_secret@localhost:5432/orbitly_dev?schema=public

# Redis Connection (BullMQ queues, rate limiting, and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=orbitly_redis_secret
REDIS_URL=redis://:orbitly_redis_secret@localhost:6379

# ------------------------------------------
# Authentication & Cryptography
# ------------------------------------------
# JWT Secrets (Minimum 32 characters in production: openssl rand -base64 32)
JWT_SECRET=super-secret-jwt-key-replace-in-production-orbitly-1234567890
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-replace-in-production-orbitly-0987654321
ADMIN_JWT_SECRET=super-secret-admin-jwt-key-replace-in-production-orbitly-9988776655
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM Master Key for OAuth Access/Refresh Tokens (64 hex characters)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Secondary encryption key for zero-downtime key rotation:
TOKEN_ENCRYPTION_KEY_V2=

# Social Login OAuth Credentials (Web UI)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# ------------------------------------------
# Email (SMTP / Mailpit for Local Testing)
# ------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Orbitly <no-reply@orbitly.app>"

# ------------------------------------------
# Storage (S3 / Cloudflare R2 / MinIO)
# ------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=orbitly-media
S3_BUCKET=orbitly-media
S3_PUBLIC_DOMAIN=http://localhost:9000/orbitly-media

# ------------------------------------------
# AI Studio & Copywriting Engine
# ------------------------------------------
# Default provider: anthropic | openai | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------
# Billing: Stripe
# ------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_TAX_ENABLED=false

STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_TEAM_MONTHLY_PRICE_ID=price_team_monthly
STRIPE_TEAM_ANNUAL_PRICE_ID=price_team_annual
STRIPE_AGENCY_MONTHLY_PRICE_ID=price_agency_monthly
STRIPE_AGENCY_ANNUAL_PRICE_ID=price_agency_annual

# ------------------------------------------
# Billing: Razorpay (India INR Add-On)
# ------------------------------------------
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholder

# ------------------------------------------
# Public API & Rate Limiting (Req / Min)
# ------------------------------------------
PUBLIC_API_RATE_LIMIT_FREE=60
PUBLIC_API_RATE_LIMIT_PRO=300
PUBLIC_API_RATE_LIMIT_TEAM=600
PUBLIC_API_RATE_LIMIT_AGENCY=1000

# ------------------------------------------
# Model Context Protocol (MCP) Server Client
# ------------------------------------------
ORBITLY_API_KEY=orb_live_placeholder
ORBITLY_API_URL=http://localhost:4000

# ------------------------------------------
# Observability, Logging & Sentry
# ------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------
# Compliance & Data Retention
# ------------------------------------------
DATA_RETENTION_DAYS_SOFT_DELETE=30

# ------------------------------------------
# Testing & Development Bypasses
# ------------------------------------------
DISABLE_WEBHOOK_VERIFY=false
