# ==========================================
# Caddyfile - Automatic HTTPS & Reverse Proxy
# ==========================================

{
    email admin@orbitly.app
    admin off
}

# Production Web Application & Landing Page
{$DOMAIN:orbitly.app} {
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Reverse proxy to Next.js App
    reverse_proxy web:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Public REST API & Webhook Ingestion
api.{$DOMAIN:orbitly.app} {
    encode gzip zstd

    # Rate limiting on API gateway
    rate_limit {
        zone api_zone {
            key {remote_host}
            events 120
            window 1m
        }
    }

    # Security Headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Access-Control-Allow-Origin "https://{$DOMAIN:orbitly.app}"
        Access-Control-Allow-Credentials "true"
    }

    # Reverse proxy to NestJS API
    reverse_proxy api:4000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}

# Object Storage Asset CDN (MinIO / R2)
media.{$DOMAIN:orbitly.app} {
    encode gzip zstd

    header {
        Cache-Control "public, max-age=31536000, immutable"
        X-Content-Type-Options "nosniff"
    }

    reverse_proxy minio:9000
}
